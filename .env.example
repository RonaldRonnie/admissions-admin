# Base URL of the Admissions Core API, including /api and no trailing slash.
# Copy to .env.local for local development. On GitHub Pages this comes from the
# repository variable API_BASE_URL instead (see .github/workflows/deploy.yml).
#
# Whatever origin serves this console must be listed in the API's ALLOWED_ORIGINS,
# or the browser blocks every request.
VITE_API_BASE_URL=http://localhost:8080/api
